{
  "schemaVersion": 1,
  "name": "superlite",
  "displayName": "Superlite",
  "version": "1.7.0",
  "description": "Lightweight Claude Code skills for the build lifecycle: one approval gate, parallel waves, short reports",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "brainstorming",
        "path": "skills/brainstorming/SKILL.md"
      },
      {
        "id": "feature-prototype",
        "path": "skills/feature-prototype/SKILL.md"
      },
      {
        "id": "finishing-a-development-branch",
        "path": "skills/finishing-a-development-branch/SKILL.md"
      },
      {
        "id": "mvp-prototype",
        "path": "skills/mvp-prototype/SKILL.md"
      },
      {
        "id": "subagent-driven-development",
        "path": "skills/subagent-driven-development/SKILL.md"
      },
      {
        "id": "systematic-debugging",
        "path": "skills/systematic-debugging/SKILL.md"
      },
      {
        "id": "test-driven-development",
        "path": "skills/test-driven-development/SKILL.md"
      },
      {
        "id": "using-superlite",
        "path": "skills/using-superlite/SKILL.md"
      },
      {
        "id": "verification-before-completion",
        "path": "skills/verification-before-completion/SKILL.md"
      },
      {
        "id": "writing-plans",
        "path": "skills/writing-plans/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "sh",
          "hooks/session-start"
        ],
        "timeoutMs": 5000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
