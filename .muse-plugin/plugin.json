{
  "schemaVersion": 1,
  "name": "superlite",
  "displayName": "Superlite",
  "version": "2.0.2",
  "description": "Lightweight Claude Code skills for the build lifecycle: one approval gate, parallel waves, short reports",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "inventing",
        "path": "skills/inventing/SKILL.md"
      },
      {
        "id": "feature-prototype",
        "path": "skills/feature-prototype/SKILL.md"
      },
      {
        "id": "shipping",
        "path": "skills/shipping/SKILL.md"
      },
      {
        "id": "mvp-prototype",
        "path": "skills/mvp-prototype/SKILL.md"
      },
      {
        "id": "swarm",
        "path": "skills/swarm/SKILL.md"
      },
      {
        "id": "diagnosis",
        "path": "skills/diagnosis/SKILL.md"
      },
      {
        "id": "testing",
        "path": "skills/testing/SKILL.md"
      },
      {
        "id": "using-superlite",
        "path": "skills/using-superlite/SKILL.md"
      },
      {
        "id": "proof",
        "path": "skills/proof/SKILL.md"
      },
      {
        "id": "drafting",
        "path": "skills/drafting/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "sh",
          "hooks/session-start"
        ],
        "timeoutMs": 5000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
