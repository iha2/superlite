#!/usr/bin/env bash
# Complexity notation:
#   a = args forwarded to the tool, p = Python candidates tried (at most 5), D = script directories searched (2)
# superlite tool launcher: bash on every platform (Git Bash on Windows), no .cmd wrappers.
#   bash <skill-dir>/scripts/sl <tool> [args...]
# <tool> is a script name without extension: incident, plan_tools, predict, pt_review,
# next_tasks, assign, dispatch, task, wave0, routing, metrics, history, report, budget, run_tests, checkpoint (old name commit_task), build_prime, finish, graphify_gate,
# orchestrator, session, exclusive, autocommit, agent_specs, testcmd, testprobe, shape, gitignore, tail, suggest_flow, proto, mvp_check, host_models,
# or probe_run (in ../probes). A tool with a .sh file runs under bash; a .py tool runs
# under one Python start:
#   1. $SUPERLITE_PYTHON, with no version check: an existing file (the path may contain
#      spaces) runs quoted, anything else is word-split (a command such as `py -3`). If it
#      is not runnable, sl warns and goes on to 2.
#   2. Else the interpreter cached by an earlier call under the same PATH, working
#      directory and VIRTUAL_ENV, if it is still executable.
#   3. Else the first candidate of python3, python, `py -3`, `uv run --no-project python`
#      that is Python 3.10+. Its real path (sys.executable) is cached in
#      ${SUPERLITE_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/superlite}/python and run
#      directly, so later calls skip the probe and the py/uv wrappers.
# Windows Store "python" stubs fail the version check and are never cached. If no Python
# works, sl says so once and exits 3, and the caller logs the gap and continues without
# that tool.
set -u  # O(1)
# UTF-8 pipes on every platform (Windows defaults Python 3.12 stdout to cp1252).
export PYTHONUTF8=1 PYTHONIOENCODING=utf-8  # O(1)

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"  # O(1) + subshell
tool="${1:-}"  # O(1)
if [ -z "$tool" ]; then  # O(1)
  echo "usage: sl <tool> [args...]" >&2  # O(1)
  exit 2  # O(1)
fi  # O(1)
shift  # O(1)

for dir in "$here" "$here/../probes"; do  # O(1)
  if [ -f "$dir/$tool.sh" ]; then exec bash "$dir/$tool.sh" "$@"; fi  # O(1) stat; exec spawns bash
  if [ -f "$dir/$tool.py" ]; then script="$dir/$tool.py"; break; fi  # O(1) stat
done  # O(1)
if [ -z "${script:-}" ]; then  # O(1)
  echo "sl: unknown tool '$tool'" >&2  # O(1)
  exit 2  # O(1)
fi  # O(1)

if [ -n "${SUPERLITE_PYTHON:-}" ]; then  # O(1)
  if [ -f "$SUPERLITE_PYTHON" ]; then sp=("$SUPERLITE_PYTHON"); else read -r -a sp <<<"$SUPERLITE_PYTHON"; fi  # O(len)
  if [ -x "${sp[0]}" ] || command -v "${sp[0]}" >/dev/null 2>&1; then  # O(1) stat or PATH lookup, no spawn
    exec "${sp[@]}" "$script" "$@"  # O(1) exec: the only Python start
  fi  # O(1)
  echo "sl: SUPERLITE_PYTHON '$SUPERLITE_PYTHON' is not runnable; searching" >&2  # O(1)
fi  # O(1)

cache_dir="${SUPERLITE_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/superlite}"  # O(1)
cache="$cache_dir/python"  # O(1)
key="${PATH}|${PWD}|${VIRTUAL_ENV:-}"  # O(len PATH) cache key: a new PATH, project or venv re-probes
if [ -f "$cache" ]; then  # O(1) stat
  { IFS= read -r cached; IFS= read -r cached_key; } < "$cache" 2>/dev/null || true  # O(1) read
  if [ -n "${cached:-}" ] && [ "${cached_key:-}" = "$key" ] && [ -x "$cached" ]; then  # O(len key)
    exec "$cached" "$script" "$@"  # O(1) exec: the only Python start
  fi  # O(1)
fi  # O(1)

# Prints the interpreter's own path when it is Python 3.10+; prints nothing otherwise.
resolve() { "$@" -c 'import sys; sys.exit(1) if sys.version_info < (3, 10) else print(sys.executable.replace("\\", "/"))' 2>/dev/null; }  # O(1) + process spawn (python startup)

run_with() {  # O(1) + one probe spawn, then exec
  local exe  # O(1)
  exe="$(resolve "$@")" || return 1  # O(1) + process spawn
  [ -n "$exe" ] || return 1  # O(1)
  if [ -x "$exe" ]; then  # O(1) stat
    if mkdir -p "$cache_dir" 2>/dev/null; then  # O(1)
      printf '%s\n%s\n' "$exe" "$key" > "$cache.$$" 2>/dev/null && mv -f "$cache.$$" "$cache" 2>/dev/null  # O(len key) atomic replace
    fi  # O(1)
    exec "$exe" "$script" ${args[@]+"${args[@]}"}  # O(1) exec spawns python
  fi  # O(1)
  exec "$@" "$script" ${args[@]+"${args[@]}"}  # O(1) no usable path: run through the wrapper
}

args=("$@")  # O(a)
for py in python3 python; do  # O(p) iterations (2)
  if command -v "$py" >/dev/null 2>&1; then run_with "$py"; fi  # O(1) lookup + probe on hit
done  # O(1)
if command -v py >/dev/null 2>&1; then run_with py -3; fi  # O(1) lookup + probe on hit
if command -v uv >/dev/null 2>&1; then run_with uv run --no-project python; fi  # O(1) lookup + probe on hit

echo "sl: no working Python 3.10+ found (tried \$SUPERLITE_PYTHON, python3, python, py -3, uv); '$tool' skipped" >&2  # O(1)
exit 3  # O(1)
