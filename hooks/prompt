#!/usr/bin/env bash
# UserPromptSubmit / beforeSubmitPrompt hook, one process per prompt, in order:
#   1. cloud   live cloud runs: `>>`, the cloud slash commands, or an attached run start `cloud hook`; a blocked
#              line ends here
#   2. _reply  record the human's reply while a human-orchestrator run waits for approval
#   3. _nudge  the compact nudge when a session is due for compact
#   4. the session HUD line and the live cost line, added only when their text changed since the last
#      prompt of this session (remembered in <run folder>/prompt-last), and always on the first prompt
# One JSON object comes out: Claude Code gets hookSpecificOutput.additionalContext, or nothing; Cursor
# (beforeSubmitPrompt) always gets {"continue":true} plus additional_context when there is text.
# SUPERLITE_NO_SESSION_HUD=1 silences the HUD, SUPERLITE_NO_COST_REPORT=1 the cost line.
# Exit 0 always. Bash builtins plus the Python helpers.

here="${BASH_SOURCE[0]//\\//}"
case "$here" in */*) here="${here%/*}" ;; *) here="." ;; esac
. "$here/_preamble" 2>/dev/null || exit 0
. "$here/_reply"
. "$here/_nudge"

is_cursor=0
re_cursor='"hook_event_name"[[:space:]]*:[[:space:]]*"beforeSubmitPrompt"'
[[ $input =~ $re_cursor ]] && is_cursor=1
[ -n "${CURSOR_AGENT:-}${CURSOR_TRACE_ID:-}${CURSOR_PLUGIN_ROOT:-}" ] && is_cursor=1

py="${SUPERLITE_PYTHON:-}"
if [ -z "$py" ]; then
  if command -v python >/dev/null 2>&1; then py=python; else py=python3; fi
fi

# Live cloud runs: one bash prefix check per prompt; Python starts only for a cloud prefix or while attached.
# The hook's own output (a block, or a backslash pass-through) is printed as is. A hook failure blocks a line meant for
# a run (`>>`, an addressed verb, an attached plain line) and lets any other line through.
# A blocked line never reaches the local agent, so it is not recorded as a human reply (record_reply runs after).
jstr prompt; cloud_line="$REPLY"
cloud_hit=0
trimmed="${cloud_line#"${cloud_line%%[![:space:]]*}"}"  # the Python hook strips the line, so the prefix check does too
case "$trimmed" in
  ">>"*|"/superlite:attach"*|"/superlite:detach"*|"/superlite:runs"*|"/superlite:watch"*|"/superlite:give"*) cloud_hit=1 ;;
  "/superlite-attach-"*|"/superlite-watch-"*) cloud_hit=1 ;;
esac
# Attachment is per session: <home>/attach/<session>.json, the key sanitised as cloud_hook.clean_key does. No session id,
# no attachment: another chat's attached run never captures this chat's prompts.
jstr session_id; att_key="$REPLY"
[ -n "$att_key" ] || { jstr conversation_id; att_key="$REPLY"; }
[ -n "$att_key" ] || att_key="${CLAUDE_CODE_SESSION_ID:-}"
# jstr leaves JSON escapes in place; decode them as clean_key sees the real string (one "_" per \uXXXX, a pair counts once).
if [[ $att_key == *\\* ]]; then
  att_key="${att_key//\\\\/$'\x01'}"
  att_key="${att_key//\\[nrtf]/ }"; att_key="${att_key//\\b/$'\x02'}"; att_key="${att_key//\\\"/\"}"; att_key="${att_key//\\\//\/}"
  re_pair='\\u[dD][89abAB][0-9a-fA-F]{2}\\u[dD][c-fC-F][0-9a-fA-F]{2}'
  while [[ $att_key =~ $re_pair ]]; do att_key="${att_key/"${BASH_REMATCH[0]}"/$'\x02'}"; done
  re_u='\\u[0-9a-fA-F]{4}'
  while [[ $att_key =~ $re_u ]]; do att_key="${att_key/"${BASH_REMATCH[0]}"/$'\x02'}"; done
  att_key="${att_key//$'\x01'/\\}"
fi
att_key="${att_key#"${att_key%%[![:space:]]*}"}"; att_key="${att_key%"${att_key##*[![:space:]]}"}"  # clean_key strips first
att_file=""
if [ -n "$att_key" ]; then
  # Explicit letters, not A-Za-z: a UTF-8 collation lets "é" into the range.
  att_key="${att_key//[^abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]/_}"
  att_file="${SUPERLITE_HOME:-$HOME/.superlite}/attach/$att_key.json"
fi
[ -n "$att_file" ] && [ -f "$att_file" ] && cloud_hit=1
if [ "$cloud_hit" = 1 ] && [ -f "$root/skills/swarm/scripts/superlite-cli" ]; then
  cloud_rc=0
  cloud_out="$(printf '%s' "$input" | bash "$root/skills/swarm/scripts/superlite-cli" cloud hook 2>/dev/null)" || cloud_rc=$?
  # A crash, a non-JSON answer or a timeout on a line meant for a run blocks it: it must not reach the local agent.
  if [ "$cloud_rc" != 0 ] || { [ -n "$cloud_out" ] && [ "${cloud_out:0:1}" != "{" ]; }; then
    cloud_out=""
    re_run='^(>>|/superlite[:-](attach|watch|give)([[:space:]-]|$)|/cancel$|/approve$)'
    if [[ $trimmed =~ $re_run ]] || { [ -n "$att_file" ] && [ -f "$att_file" ] && [ -n "$trimmed" ] \
         && [[ $trimmed != "/"* ]] && [[ $trimmed != "\\"* ]]; }; then
      why="not sent: cloud hook failed; the line did not reach the run"
      if [ "$is_cursor" = 1 ]; then cloud_out="{\"continue\":false,\"user_message\":\"$why\"}"
      else cloud_out="{\"decision\":\"block\",\"reason\":\"$why\"}"; fi
    fi
  fi
  if [ -n "$cloud_out" ]; then
    re_blocked='"(decision"[[:space:]]*:[[:space:]]*"block"|continue"[[:space:]]*:[[:space:]]*false)'
    [[ $cloud_out =~ $re_blocked ]] || record_reply   # a backslash pass-through still goes to the local agent
    printf '%s\n' "$cloud_out"; exit 0
  fi
fi

record_reply
compact_nudge

# The HUD and the cost line read the folder the host names (proj0), not the run found above it.
hud=""
hud_script="$root/skills/swarm/scripts/session_hud.py"
if [ "${SUPERLITE_NO_SESSION_HUD:-}" != "1" ] && [ -f "$hud_script" ] && { [ -d "$proj0/.superlite" ] || [ -f "$proj0/.git" ]; }; then
  hud="$("$py" "$hud_script" "$proj0" 2>/dev/null)" || hud=""
fi
cost=""
if [ "${SUPERLITE_NO_COST_REPORT:-}" != "1" ] && [ -d "$proj0/.superlite" ]; then
  cost="$("$py" "$root/skills/swarm/scripts/cost.py" line "$proj0/.superlite" 2>/dev/null)" || cost=""
fi
lines="$hud"
if [ -n "$cost" ]; then lines="${lines:+$lines$'\n'}$cost"; fi

# Same text as the last prompt of this session: say nothing.
last_file="$proj0/.superlite/prompt-last"
if [ -d "$proj0/.superlite" ]; then
  jstr session_id; sid="$REPLY"
  [ -n "$sid" ] || { jstr conversation_id; sid="$REPLY"; }
  mark="$sid"$'\n'"$lines"
  last=""
  [ -f "$last_file" ] && IFS= read -r -d '' last < "$last_file"
  printf '%s' "$mark" > "$last_file" 2>/dev/null
  [ -n "$lines" ] && [ "$mark" = "$last" ] && lines=""
fi

ctx="$NUDGE"
if [ -n "$lines" ]; then ctx="${ctx:+$ctx$'\n'}$lines"; fi
if [ -z "$ctx" ]; then
  [ "$is_cursor" = 1 ] && printf '{"continue":true}\n'
  exit 0
fi
esc ctx
if [ "$is_cursor" = 1 ]; then
  printf '{"continue":true,"additional_context":"%s"}\n' "$ctx"
elif [ -n "${CLAUDE_CODE:-}" ] || [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"%s"}}\n' "$ctx"
else
  printf '{"additionalContext":"%s"}\n' "$ctx"
fi
exit 0
