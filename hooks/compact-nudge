#!/usr/bin/env bash
# UserPromptSubmit (or similar) nudge: when a superlite session is due for compact, emit a
# host-neutral additionalContext line. Silent when SUPERLITE_NO_AUTOCOMPACT=1 or not due.
# Bash + one Python call (compact_due). Exit 0 always (fail open).

# Opt out: no nudge text.
if [ "${SUPERLITE_NO_AUTOCOMPACT:-}" = "1" ]; then
  exit 0
fi

IFS= read -r -d '' input || true

re='"cwd"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
in_cwd=""
if [[ ${input:-} =~ $re ]]; then
  in_cwd="${BASH_REMATCH[1]//\\\\//}"
  in_cwd="${in_cwd//\\\"/\"}"
fi
proj="${CLAUDE_PROJECT_DIR:-$in_cwd}"
[ -n "$proj" ] || proj="$PWD"
# A session worktree sits below the project: the run at or above the input cwd wins.
if [ -n "$in_cwd" ]; then
  d="$in_cwd"
  while [ ! -f "$d/.superlite/orchestrator.json" ]; do
    up="${d%/*}"; { [ -z "$up" ] || [ "$up" = "$d" ]; } && break; d="$up"
  done
  [ -f "$d/.superlite/orchestrator.json" ] && proj="$d"
fi
sl_dir="${proj}/.superlite"
[ -d "$sl_dir" ] || exit 0

root="${CLAUDE_PLUGIN_ROOT:-}"
if [ -z "$root" ]; then
  self="${BASH_SOURCE[0]//\\//}"
  case "$self" in /*|?:/*) ;; *) self="${PWD//\\//}/$self" ;; esac
  root="${self%/hooks/*}"
fi
root="${root//\\//}"
py="${SUPERLITE_PYTHON:-}"
if [ -z "$py" ]; then
  if command -v python >/dev/null 2>&1; then py=python; else py=python3; fi
fi
script="$root/skills/swarm/scripts/compact_due.py"

line="$("$py" "$script" "$sl_dir" 2>/dev/null)" || exit 0
[ -n "$line" ] || exit 0

# JSON-escape the nudge.
esc="$line"
esc="${esc//\\/\\\\}"
esc="${esc//\"/\\\"}"
esc="${esc//$'\r'/}"
esc="${esc//$'\n'/\\n}"
esc="${esc//$'\t'/\\t}"

if [ -n "${CURSOR_AGENT:-}${CURSOR_TRACE_ID:-}" ] || [ "${CLAUDE_CODE:-}" = "1" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"%s"}}\n' "$esc"
else
  printf '{"additionalContext":"%s"}\n' "$esc"
fi
exit 0
