#!/usr/bin/env bash
# UserPromptSubmit hook (Cursor: beforeSubmitPrompt): while a human-orchestrator run is unapproved (.superlite/orchestrator.json
# has mode human and approved false), or a feature-flow try-out waits for the human (mode human and
# .superlite/feature.json has status tryout), append one line per human prompt to
# <project>/.superlite/human-replies.jsonl:
#   {"t":<epoch ms>,"approves":true|false,"text":"<first 160 chars of the prompt>"}
# approves is true when the prompt expresses approval in any common way (approve, yes, yeah, yep,
# ok, okay, sure, go ahead, looks good, sounds good, lgtm, proceed, it works, and similar), including
# a long reply or one that also names a change. It is false for an explicit refusal (don't approve,
# do not proceed), a real question (should I approve?, can we go ahead?), or a message that only
# mentions approving. Only this hook writes the file.
# Bash builtins only (each external process costs ~250 ms on Windows). Never blocks: exit 0 always.

IFS= read -r -d '' input   # builtin; returns 1 at EOF, which is fine

# Cursor (beforeSubmitPrompt) waits for {"continue":true}; Claude Code (UserPromptSubmit) gets no output.
re_cursor='"hook_event_name"[[:space:]]*:[[:space:]]*"beforeSubmitPrompt"'
[[ $input =~ $re_cursor ]] && trap 'printf "{\"continue\":true}\n"' EXIT

# jdecode S: JSON string body S, decoded, into REPLY.
jdecode() {
  local s="$1"
  s="${s//\\\\/$'\x01'}"; s="${s//\\\"/\"}"; s="${s//\\n/ }"; s="${s//\\r/}"; s="${s//\\t/ }"; s="${s//\\\//\/}"
  REPLY="${s//$'\x01'/\\}"
}

# jstr KEY: first JSON string value for KEY, decoded, into REPLY (empty if absent).
jstr() {
  local re='"'"$1"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
  REPLY=""
  [[ $input =~ $re ]] || return 0
  jdecode "${BASH_REMATCH[1]}"
}

# Project: Claude Code's env or cwd; Cursor runs plugin hooks elsewhere, so its env or the first
# workspace root (sent as /c:/path) that holds a superlite run.
jstr cwd; proj="${CLAUDE_PROJECT_DIR:-${CURSOR_PROJECT_DIR:-${REPLY//\\//}}}"
if [ -z "$proj" ]; then
  re_roots='"workspace_roots"[[:space:]]*:[[:space:]]*\[([^]]*)\]'
  re_item='^[^"]*"(([^"\\]|\\.)*)"(.*)$'
  re_drive='^/([A-Za-z]:/.*)$'
  if [[ $input =~ $re_roots ]]; then
    rest="${BASH_REMATCH[1]}"
    while [[ $rest =~ $re_item ]]; do
      rest="${BASH_REMATCH[3]}"
      jdecode "${BASH_REMATCH[1]}"; r="${REPLY//\\//}"
      [[ $r =~ $re_drive ]] && r="${BASH_REMATCH[1]}"
      [ -n "$proj" ] || proj="$r"
      [ -f "$r/.superlite/orchestrator.json" ] && { proj="$r"; break; }
    done
  fi
fi
[ -n "$proj" ] || proj="$PWD"
sd="$proj/.superlite"
[ -f "$sd/orchestrator.json" ] || exit 0
IFS= read -r -d '' oj < "$sd/orchestrator.json"
re_human='"mode"[[:space:]]*:[[:space:]]*"human"'
re_unappr='"approved"[[:space:]]*:[[:space:]]*false'
[[ $oj =~ $re_human ]] || exit 0
if ! [[ $oj =~ $re_unappr ]]; then
  [ -f "$sd/feature.json" ] || exit 0
  IFS= read -r -d '' fj < "$sd/feature.json"
  re_tryout='"status"[[:space:]]*:[[:space:]]*"tryout"'
  [[ $fj =~ $re_tryout ]] || exit 0
fi

jstr prompt; text="$REPLY"
lc="${text,,}"
lc="${lc//$'\u2019'/\'}"; lc="${lc//$'\u2018'/\'}"

# Drop real questions ("should I approve?", "can we go ahead?"). Keep every other clause, so
# "looks good, can you add tests?" and a bare "approve?" still count.
statements=""
rest="$lc"
re_q='^(can|could|should|would|do|does|did|is|are|am|will|what|when|where|why|how|who|whom|which|may|shall)([^[:alnum:]_]|$)'
while [[ $rest == *'?'* ]]; do
  clause="${rest%%\?*}"
  rest="${rest#*\?}"
  head=""; tail="$clause"
  if [[ $clause =~ ^(.*[.!])(.*)$ ]]; then
    head="${BASH_REMATCH[1]}"
    tail="${BASH_REMATCH[2]}"
  fi
  trimmed="${tail#"${tail%%[![:space:]]*}"}"
  if [[ $trimmed =~ $re_q ]]; then
    statements+=" $head"
  else
    statements+=" $head $tail"
  fi
done
statements+=" $rest"

# Explicit refusals and mere mentions, longest first, so they cannot count as a yes.
for phrase in \
  "do not go ahead" "don't go ahead" "dont go ahead" \
  "do not proceed" "don't proceed" "dont proceed" \
  "do not continue" "don't continue" "dont continue" \
  "do not ship it" "don't ship it" "dont ship it" \
  "do not do this" "don't do this" "dont do this" \
  "do not do it" "don't do it" "dont do it" \
  "do not approve" "don't approve" "dont approve" \
  "never approve" "not approved" "not approve" \
  "cannot approve" "can't approve" "cant approve" \
  "not okay" "not ok" "not sure" "not perfect" \
  "you approve" "make sure"
do
  statements="${statements//$phrase/ }"
done

b='(^|[^[:alnum:]_])'; e='([^[:alnum:]_]|$)'
re_yes="$b(approved|approve|absolutely|definitely|affirmative|accepted|agreed|agree|alright|all[[:space:]]+right|all[[:space:]]+good|go[[:space:]]+ahead|go[[:space:]]+for[[:space:]]+it|good[[:space:]]+to[[:space:]]+go|good[[:space:]]+enough|good[[:space:]]+with[[:space:]]+me|green[[:space:]]+light|looks[[:space:]]+great|looks[[:space:]]+good|looks[[:space:]]+fine|sounds[[:space:]]+great|sounds[[:space:]]+good|sounds[[:space:]]+fine|let'?s[[:space:]]+do[[:space:]]+this|lets[[:space:]]+do[[:space:]]+this|let'?s[[:space:]]+do[[:space:]]+it|lets[[:space:]]+do[[:space:]]+it|let'?s[[:space:]]+go|lets[[:space:]]+go|full[[:space:]]+send|fine[[:space:]]+by[[:space:]]+me|fine[[:space:]]+with[[:space:]]+me|works[[:space:]]+for[[:space:]]+me|it[[:space:]]+works|this[[:space:]]+works|that[[:space:]]+works|i'?m[[:space:]]+good|im[[:space:]]+good|i[[:space:]]+accept|i[[:space:]]+like[[:space:]]+it|love[[:space:]]+it|make[[:space:]]+it[[:space:]]+so|run[[:space:]]+with[[:space:]]+it|carry[[:space:]]+on|copy[[:space:]]+that|please[[:space:]]+continue|sign[[:space:]]+off|signed[[:space:]]+off|ship[[:space:]]+it|build[[:space:]]+it|send[[:space:]]+it|do[[:space:]]+this|do[[:space:]]+it|thumbs[[:space:]]+up|okay|ok|yeah|yep|yup|yes|sure|lgtm|sgtm|proceed|continue|perfect|roger)$e"
approves=false
# Thumbs-up, check mark, ok-hand: the character itself, or the \u escape JSON leaves in the prompt.
[[ $statements =~ $re_yes || $text == *$'\U1F44D'* || $text == *$'\U2705'* || $text == *$'\U1F44C'* \
  || $lc == *'\ud83d\udc4d'* || $lc == *'\u2705'* || $lc == *'\ud83d\udc4c'* ]] && approves=true

text="${text:0:160}"
text="${text//\\/\\\\}"; text="${text//\"/\\\"}"
now="${EPOCHREALTIME//[.,]/}"; now="${now:0:${#now}-3}"
printf '{"t":%s,"approves":%s,"text":"%s"}\n' "$now" "$approves" "$text" >> "$sd/human-replies.jsonl" 2>/dev/null
exit 0
