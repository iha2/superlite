#!/usr/bin/env bash
# UserPromptSubmit hook (Cursor: beforeSubmitPrompt): while a human-orchestrator run is unapproved (.superlite/orchestrator.json
# has mode human and approved false), or a feature-flow try-out waits for the human (mode human and
# .superlite/feature.json has status tryout), append one line per human prompt to
# <project>/.superlite/human-replies.jsonl:
#   {"t":<epoch ms>,"approves":true|false,"text":"<first 160 chars of the prompt>"}
# approves is true when the prompt contains an approval phrase (approve, approved, yes, go ahead,
# go for it, looks good, lgtm, proceed, ship it, do it, it works, works for me, all good) and none
# of: not, don't, dont, no, wait, stop, but, change, instead (case-insensitive, whole words). Only this hook writes the file.
# Bash builtins only (each external process costs ~250 ms on Windows). Never blocks: exit 0 always.

IFS= read -r -d '' input   # builtin; returns 1 at EOF, which is fine

# Cursor (beforeSubmitPrompt) waits for {"continue":true}; Claude Code (UserPromptSubmit) gets no output.
re_cursor='"hook_event_name"[[:space:]]*:[[:space:]]*"beforeSubmitPrompt"'
[[ $input =~ $re_cursor ]] && trap 'printf "{\"continue\":true}\n"' EXIT

# jdecode S: JSON string body S, decoded, into REPLY.
jdecode() {
  local s="$1"
  s="${s//\\\\/$'\x01'}"; s="${s//\\\"/\"}"; s="${s//\\n/ }"; s="${s//\\r/}"; s="${s//\\t/ }"; s="${s//\\\//\/}"
  REPLY="${s//$'\x01'/\\}"
}

# jstr KEY: first JSON string value for KEY, decoded, into REPLY (empty if absent).
jstr() {
  local re='"'"$1"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
  REPLY=""
  [[ $input =~ $re ]] || return 0
  jdecode "${BASH_REMATCH[1]}"
}

# Project: Claude Code's env or cwd; Cursor runs plugin hooks elsewhere, so its env or the first
# workspace root (sent as /c:/path) that holds a superlite run.
jstr cwd; proj="${CLAUDE_PROJECT_DIR:-${CURSOR_PROJECT_DIR:-${REPLY//\\//}}}"
if [ -z "$proj" ]; then
  re_roots='"workspace_roots"[[:space:]]*:[[:space:]]*\[([^]]*)\]'
  re_item='^[^"]*"(([^"\\]|\\.)*)"(.*)$'
  re_drive='^/([A-Za-z]:/.*)$'
  if [[ $input =~ $re_roots ]]; then
    rest="${BASH_REMATCH[1]}"
    while [[ $rest =~ $re_item ]]; do
      rest="${BASH_REMATCH[3]}"
      jdecode "${BASH_REMATCH[1]}"; r="${REPLY//\\//}"
      [[ $r =~ $re_drive ]] && r="${BASH_REMATCH[1]}"
      [ -n "$proj" ] || proj="$r"
      [ -f "$r/.superlite/orchestrator.json" ] && { proj="$r"; break; }
    done
  fi
fi
[ -n "$proj" ] || proj="$PWD"
sd="$proj/.superlite"
[ -f "$sd/orchestrator.json" ] || exit 0
IFS= read -r -d '' oj < "$sd/orchestrator.json"
re_human='"mode"[[:space:]]*:[[:space:]]*"human"'
re_unappr='"approved"[[:space:]]*:[[:space:]]*false'
[[ $oj =~ $re_human ]] || exit 0
if ! [[ $oj =~ $re_unappr ]]; then
  [ -f "$sd/feature.json" ] || exit 0
  IFS= read -r -d '' fj < "$sd/feature.json"
  re_tryout='"status"[[:space:]]*:[[:space:]]*"tryout"'
  [[ $fj =~ $re_tryout ]] || exit 0
fi

jstr prompt; text="$REPLY"
lc="${text,,}"
b='(^|[^[:alnum:]_])'; e='([^[:alnum:]_]|$)'
re_yes="$b(approve|approved|yes|go[[:space:]]+ahead|go[[:space:]]+for[[:space:]]+it|looks[[:space:]]+good|lgtm|proceed|ship[[:space:]]+it|do[[:space:]]+it|it[[:space:]]+works|works[[:space:]]+for[[:space:]]+me|all[[:space:]]+good)$e"
re_no="$b(not|don't|don’t|dont|no|wait|stop|but|change|instead)$e"
approves=false
[[ $lc =~ $re_yes ]] && ! [[ $lc =~ $re_no ]] && approves=true

text="${text:0:160}"
text="${text//\\/\\\\}"; text="${text//\"/\\\"}"
now="${EPOCHREALTIME//[.,]/}"; now="${now:0:${#now}-3}"
printf '{"t":%s,"approves":%s,"text":"%s"}\n' "$now" "$approves" "$text" >> "$sd/human-replies.jsonl" 2>/dev/null
exit 0
