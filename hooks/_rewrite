# Sourced by hooks/pre-tool: during an active superlite run, rewrite the COORDINATOR's raw test runs
# (pytest, npm test, npx vitest|jest, go test, cargo test, dotnet test, ...) into a background
# `superlite-cli run_tests --full`, or `superlite-cli run_tests --fast <files>` when the raw command names test/source paths.
# Subagents (agent_id): bare full-suite runners are DENIED (exit 2); other subagent calls are untouched.
# Commands that already contain run_tests, and sessions without a run marker (.superlite/stable.json,
# prime.md or pool.json) are untouched. Chained commands keep their other work: only the test segment
# is replaced, separators stay, and the whole command then runs in the background. Anything ambiguous
# (odd quotes, heredocs, \u escapes) passes unchanged. Each rewrite is logged to
# .superlite/incidents.jsonl (rule-rewrite). DENIED instead (exit 2, rule-block incident): a known test
# runner inside an until/while loop, or a test run with stdout sent to /dev/null; also a subagent bare
# full suite. Only known runners match, so `until curl ...` and `until [ -f x ]` pass.
# Returning means allow (a rewrite prints its JSON first); exit 2 is a denial.

guard_rewrite() {
shopt -u patsub_replacement 2>/dev/null   # bash 5.2+: `&` in a ${x//a/&} replacement must stay literal

re_agent='"(agent_id|parent_tool_call_id)"[[:space:]]*:[[:space:]]*"[^"]'
has_agent=0
[[ $input =~ $re_agent ]] && has_agent=1
re_tool='"tool_name"[[:space:]]*:[[:space:]]*"(Bash|Shell)"'
[[ $input =~ $re_tool ]] || return 0
[ "$active" = 1 ] || return 0
re_cursor='"hook_event_name"[[:space:]]*:[[:space:]]*"preToolUse"'
cursor=0; [[ $input =~ $re_cursor ]] && cursor=1

# jdec KEY: first JSON string value for KEY, decoded, into REPLY (empty if absent).
jdec() {
  local re='"'"$1"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"' jv
  REPLY=""
  [[ $input =~ $re ]] || return 0
  jv="${BASH_REMATCH[1]}"
  jdecode jv rewrite   # (not named s: jdecode has a local s)
  REPLY="$jv"
}

# Without a runner word in the raw command (and no project runner list) there is nothing to deny or rewrite.
if [ ! -f "$sd/test-cmd.json" ]; then
  jstr command
  case "$REPLY" in *test*|*jest*|*mocha*|*rspec*) ;; *) return 0 ;; esac
fi
jdec command; cmd="$REPLY"
[ -n "$cmd" ] || return 0
case "$cmd" in *run_tests*|*'<<'*|*'\u'*) return 0 ;; esac

sl_base="bash \"$root/skills/swarm/scripts/superlite-cli\" run_tests"
sl="$sl_base --full"

# A test segment: optional env assignments and runner prefix, then a known runner.
re_test='^[[:space:]]*([A-Za-z_][A-Za-z_0-9]*=[^[:space:]]*[[:space:]]+)*((uv|poetry|pipenv|pdm|hatch)[[:space:]]+run[[:space:]]+)?(((python[0-9.]*|py)([[:space:]]+-[0-9]+)?[[:space:]]+-m[[:space:]]+)?(pytest|py\.test|unittest)|((npm|pnpm|yarn|bun)[[:space:]]+(run[[:space:]]+)?test)|((npx|pnpm[[:space:]]+(exec|dlx)|bunx|yarn)[[:space:]]+(--no-install[[:space:]]+)?(vitest|jest))|(vitest|jest)|(go|cargo|dotnet)[[:space:]]+test)([[:space:]]|$)'
re_seg='^([^&|;'$'\n'']*)(&&|\|\||;|\||'$'\n''|&)(.*)$'

# files_from_seg SEG: path-like args after the runner into REPLY (empty = bare / full suite).
files_from_seg() {
  local rest w
  REPLY=""
  [[ $1 =~ $re_test ]] || return 0
  rest="${1#"${BASH_REMATCH[0]}"}"
  for w in $rest; do
    case "$w" in
      -*|--[[:alnum:]-]*) continue ;;
      /dev/null|[Nn][Uu][Ll]|*/null) continue ;;  # redirects, not test paths
      */*|*\\*|*.py|*.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.go|*.rs|*.rb|*.cs) REPLY="${REPLY:+$REPLY }$w" ;;
    esac
  done
}

ph1=$'\x02'; ph2=$'\x03'
amp_placeholders cmd   # keep 2>&1 and &> out of the separator split

# Hidden test waits are denied, not rewritten: a known runner inside an until/while loop, or a test run
# whose stdout goes to /dev/null, makes a hung run look like a slow one. The way is `superlite-cli run_tests --wait`.
# Known runners only, at command position, so `until curl ...` or `until [ -f .../vitest ]` pass.
sp='[[:space:]]'
re_env="([A-Za-z_][A-Za-z_0-9]*=[^[:space:]]*$sp+)*"
re_uv="((uv|poetry|pipenv|pdm|hatch)${sp}+run${sp}+)?"
re_core="(((python[0-9.]*|py)(${sp}+-[0-9]+)?${sp}+-m${sp}+)?(pytest|py\.test|unittest)|((npx|pnpx|bunx|yarn|pnpm(${sp}+(exec|dlx))?|npm${sp}+exec|bun${sp}+x)${sp}+(-[-A-Za-z]+${sp}+)*)?(vitest|jest|mocha)|(npm|pnpm|yarn|bun)${sp}+(run${sp}+)?test|(go|cargo|dotnet)${sp}+test|(bundle${sp}+exec${sp}+)?rspec|(mvn|mvnw|\./mvnw|gradle|gradlew|\./gradlew)${sp}+(-[^[:space:]]+${sp}+)*(clean${sp}+)?test)"
re_known="^$sp*(![[:space:]]*)?$re_env$re_uv$re_core($sp|\$|[;&|)])"
re_loop="(^|[^[:alnum:]_.-])(until|while)$sp"
re_in_loop="(^|[;&|({]|(^|$sp)(until|while|do|then|elif|if))$sp*(!$sp*)?$re_env$re_uv$re_core($sp|\$|[;&|)])"
re_null="(^|[^0-9])(>>?|$ph2>?)$sp*(/dev/null|[Nn][Uu][Ll])([^[:alnum:]_./]|\$)|(^|$sp)1>>?$sp*(/dev/null|[Nn][Uu][Ll])([^[:alnum:]_./]|\$)"

# The project's own test command (.superlite/test-cmd.json "test", "test_file"): its leading words up to the
# first flag, placeholder or quote (two words or a path, no glob characters) count as a known runner.
pp=()
load_project_runner() {
  local tc w words key re f n p
  f="$sd/test-cmd.json"
  [ -f "$f" ] || return 0
  read -r -d '' tc < "$f"
  for key in test test_file; do
    re='"'"$key"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
    [[ $tc =~ $re ]] || continue
    read -r -a words <<< "${BASH_REMATCH[1]}"
    p=""; n=0
    for w in "${words[@]}"; do
      case "$w" in -*|*"{"*|*=*|*'"'*|*"'"*|*'$'*|*'\'*|*'*'*|*'?'*|*'['*) break ;; esac
      p="${p:+$p }$w"; n=$((n+1))
    done
    if [ "$n" -ge 2 ] || { [ "$n" = 1 ] && [[ $p == */* ]]; }; then pp+=("$p"); fi
  done
}
# project_hit TEXT MODE: 0 when TEXT holds a project runner (MODE seg: at its start; loop: at any command position).
project_hit() {
  local p t pat
  for p in "${pp[@]}"; do
    if [ "$2" = seg ]; then
      t="${1#"${1%%[![:space:]]*}"}"
      [[ "$t " == "$p "* ]] && return 0
    else
      pat=$'*[[:space:];&|(!]'"$p"$'[[:space:];&|)]*'
      [[ " $1 " == $pat ]] && return 0
    fi
  done
  return 1
}
deny() {
  local t="${cmd:0:100}"; t="${t//[\"\\$'\n\r\t']/ }"
  t="${t//$ph1/>&}"; t="${t//$ph2/&>}"
  printf '{"kind":"rule-block","agent":"coordinator","tool":"Bash","target":"hidden test wait: %s"}\n' "$t" \
    >> "$sd/incidents.jsonl" 2>/dev/null
  printf '%s\n' \
    'Blocked: never wait on tests through a loop, and never hide a test run'"'"'s output (an until/while around a test runner, or a test run sent to /dev/null): a hung run then looks like a slow one, and the loop bypasses the test wrapper.' \
    'Start the run with `superlite-cli run_tests --full --background` (focused: `superlite-cli run_tests --fast <file>`), then wait with `superlite-cli run_tests --wait`. It returns early with `SUSPECT HANG`, the verdict (blocked or spinning) and the process tree when the run stops producing output, and its summary names a TIMEOUT or a kill instead of a bare exit code.' >&2
  exit 2
}
deny_subagent_full() {
  local t="${cmd:0:100}"; t="${t//[\"\\$'\n\r\t']/ }"
  printf '{"kind":"rule-block","agent":"subagent","tool":"Bash","target":"full suite: %s"}\n' "$t" \
    >> "$sd/incidents.jsonl" 2>/dev/null
  printf '%s\n' \
    'Blocked: subagents must not run the full test suite during a superlite run.' \
    'Use `superlite-cli run_tests --fast <files>` for focused tests only.' >&2
  exit 2
}

# A big command with no runner at a command position has no segment to deny or rewrite (the segment loops below
# are quadratic in the number of segments).
re_any="(^|[^[:alnum:]_.-])${re_test#^}"
runner_any=1
if [ "${#cmd}" -ge "$BIG" ] && ! [[ $cmd =~ $re_any ]]; then runner_any=0; fi

# Subagents: deny a bare full-suite runner; leave everything else untouched.
if [ "$has_agent" = 1 ]; then
  case "$cmd" in *test*|*jest*) ;; *) return 0 ;; esac   # every runner pattern holds "test" or "jest"
  [ "$runner_any" = 1 ] || return 0
  _rest="$cmd"; _last=0
  while :; do
    if [[ $_rest =~ $re_seg ]]; then _seg="${BASH_REMATCH[1]}"; _rest="${BASH_REMATCH[3]}"; _last=0
    else _seg="$_rest"; _last=1; fi
    if [[ $_seg =~ $re_test ]]; then
      files_from_seg "$_seg"
      [ -z "$REPLY" ] && deny_subagent_full
    fi
    [ "$_last" = 1 ] && break
  done
  return 0
fi

case "$cmd" in *until*|*while*|*null*|*[Nn][Uu][Ll]*) hid=1 ;; *) hid=0 ;; esac
if [ "$hid" = 1 ]; then
  load_project_runner
  if [[ $cmd =~ $re_loop ]]; then
    [[ $cmd =~ $re_in_loop ]] && deny
    [ "${#pp[@]}" -gt 0 ] && project_hit "$cmd" loop && deny
  fi
fi

# Without a runner word (the project's own runners aside) there is nothing to deny or rewrite.
case "$cmd" in *test*|*jest*|*mocha*|*rspec*) ;; *) [ "${#pp[@]}" -gt 0 ] || return 0 ;; esac
[ "$hid" = 1 ] || [ "$runner_any" = 1 ] || return 0

out=""; rest="$cmd"; changed=0; used_fast=0
while :; do
  if [[ $rest =~ $re_seg ]]; then seg="${BASH_REMATCH[1]}"; sep="${BASH_REMATCH[2]}"; rest="${BASH_REMATCH[3]}"; last=0
  else seg="$rest"; sep=""; last=1; fi
  if [ "$hid" = 1 ] && [[ $seg =~ $re_null ]]; then   # a known runner with stdout sent to /dev/null
    if [[ $seg =~ $re_known ]]; then deny; fi
    if [ "${#pp[@]}" -gt 0 ] && project_hit "$seg" seg; then deny; fi
  fi
  # A quote that spans a separator: an odd number of quotes in the segment.
  count_char seg '"'; q=$COUNT; count_char seg "'"; q2=$COUNT
  if [ $(( q % 2 )) = 1 ] || [ $(( q2 % 2 )) = 1 ]; then return 0; fi
  if [[ $seg =~ $re_test ]]; then
    files_from_seg "$seg"
    if [ -n "$REPLY" ]; then out="$out $sl_base --fast $REPLY "; used_fast=1
    else out="$out $sl "; fi
    changed=1
  else out="$out$seg"; fi
  out="$out$sep"
  [ "$last" = 1 ] && break
done
[ "$changed" = 1 ] || return 0

orig="${cmd:0:120}"; orig="${orig//[\"\\$'\n\r\t']/ }"
printf '{"kind":"rule-rewrite","agent":"coordinator","tool":"Bash","command":"%s"}\n' "$orig" \
  >> "$sd/incidents.jsonl" 2>/dev/null

out="${out//$ph1/>&}"; out="${out//$ph2/&>}"
esc out
if [ "$used_fast" = 1 ]; then mode=fast; else mode=full; fi
if [ "$cursor" = 1 ]; then   # Cursor reads permission plus updated_input, not hookSpecificOutput
  printf '%s\n' '{"permission":"allow","updated_input":{"command":"'"$out"'"},"agent_message":"raw test run rewritten to a superlite-cli run_tests --'"$mode"'; its summary is in .superlite/tests/summary.json"}'
  return 0
fi
printf '%s' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","updatedInput":{"command":"'"$out"'","run_in_background":true,"description":"superlite-cli run_tests --'"$mode"' (rewritten from a raw test run)"},"additionalContext":"raw test run rewritten to a background superlite-cli run_tests --'"$mode"'; its result arrives as a notification and in .superlite/tests/summary.json; use `superlite-cli run_tests --wait` only at the final gate"}}'
printf '\n'
return 0
}
