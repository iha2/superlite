#!/usr/bin/env bash
# Complexity notation:
#   s = bytes of skills/using-superlite/SKILL.md; each ${s//x/y} is one O(s) pass
# SessionStart hook for the superlite plugin (Claude Code, Cursor, Copilot CLI, Muse and other SDK-style hosts)

set -euo pipefail  # O(1)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"  # O(1) + subshell
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"  # O(1) + subshell

content=$(cat "${PLUGIN_ROOT}/skills/using-superlite/SKILL.md" 2>&1 || echo "Error reading using-superlite skill")  # O(s) read

escape_for_json() {  # O(s)
    local s="$1"  # O(s)
    s="${s//\\/\\\\}"  # O(s)
    s="${s//\"/\\\"}"  # O(s)
    s="${s//$'\r'/}"  # O(s) drop CR: a CRLF checkout must not change the text
    s="${s//$'\n'/\\n}"  # O(s)
    s="${s//$'\t'/\\t}"  # O(s)
    printf '%s' "$s"  # O(s)
}  # O(1)

# Interpreter for the helper scripts: $SUPERLITE_PYTHON, else python, else python3 (builtin probe, no spawn).
py="${SUPERLITE_PYTHON:-}"  # O(1)
if [ -z "$py" ]; then  # O(1)
  if command -v python >/dev/null 2>&1; then py=python; else py=python3; fi  # O(PATH)
fi  # O(1)

# Which superlite session (slug, branch, worktree) this checkout is, when sessions are registered.
hud_line=""  # O(1)
if [ "${SUPERLITE_NO_SESSION_HUD:-}" != "1" ] && { [ -d .superlite ] || [ -f .git ]; }; then  # O(1)
  hud_line="$("$py" "${PLUGIN_ROOT}/skills/swarm/scripts/session_hud.py" . 2>/dev/null || true)"  # O(N)
fi  # O(1)

# Project state hint for the start menu: bash builtins only (no spawned process).
state="empty folder"  # O(1)
shopt -s nullglob dotglob  # O(1)
entries=(./*)  # O(n) directory entries
if [[ $hud_line == *' | run:open' ]] && [ -f .superlite/orchestrator.json ]; then  # O(1) open run in this checkout
  state="run in progress"  # O(1)
elif [[ $hud_line == *' | run:'* ]]; then  # O(1) session row, no open run here: the code stays
  state="existing code"  # O(1)
elif [ -f .superlite/orchestrator.json ] && [ -d docs/plans ]; then  # O(1) no session row: the orchestrator check
  state="run in progress"  # O(1)
elif [ -d .git ] || [ "${#entries[@]}" -gt 0 ]; then  # O(1)
  state="existing code"  # O(1)
fi  # O(1)
shopt -u nullglob dotglob  # O(1)
content="${content}"$'

'"Project state: ${state}."  # O(s)

# First session after this version is installed: show the intro screen once. The marker lives in
# $SUPERLITE_HOME (default $XDG_DATA_HOME/superlite, or an existing ~/.superlite), one file per version, so an upgrade shows it again.
version=""  # O(1)
if [ -f "${PLUGIN_ROOT}/.claude-plugin/plugin.json" ]; then  # O(1)
  IFS= read -r -d '' pj < "${PLUGIN_ROOT}/.claude-plugin/plugin.json" || true  # O(file) builtin
  re_ver='"version"[[:space:]]*:[[:space:]]*"([^"]+)"'  # O(1)
  [[ $pj =~ $re_ver ]] && version="${BASH_REMATCH[1]}"  # O(file)
fi  # O(1)
# Same rule as history.home() in skills/swarm/scripts/history.py: change both together.
if [ -n "${SUPERLITE_HOME:-}" ]; then home="$SUPERLITE_HOME"  # O(1)
elif [ -d "${HOME:-}/.superlite" ]; then home="${HOME}/.superlite"  # O(1)
elif [[ ${XDG_DATA_HOME:-} == /* ]]; then home="${XDG_DATA_HOME}/superlite"  # O(1)
else home="${HOME:-}/.local/share/superlite"  # O(1)
fi  # O(1)
marker="${home}/intro-shown-${version:-unknown}"  # O(1)
if [ -n "${HOME:-}${SUPERLITE_HOME:-}" ] && [ -f "${PLUGIN_ROOT}/assets/intro.txt" ] && [ ! -e "$marker" ]; then  # O(1)
  { [ -d "$home" ] || mkdir -p "$home"; } 2>/dev/null && : > "$marker" 2>/dev/null || true  # first run only: one spawn
  # Embed the screen here: the plugin path is outside the project, so a Read of
  # assets/intro.txt often fails or is skipped on a fresh install.
  IFS= read -r -d '' intro_body < "${PLUGIN_ROOT}/assets/intro.txt" || true  # O(intro)
  intro_body="${intro_body//$'\r'/}"  # O(intro) drop CR
  if [ -n "$intro_body" ]; then  # O(1)
    content="${content}"$'

'"superlite ${version} was just installed. Before anything else in your first reply, print the following intro screen to the user verbatim inside one text code block (do not call Read for it), then continue with their request. Do this only once.

\`\`\`text
${intro_body}
\`\`\`"  # O(s+intro)
  fi  # O(1)
fi  # O(1)

# One-time prefer for pre-impl specs (default remains off until prefer on). Marker: agent_specs key in preferences.json.
prefs="${home}/preferences.json"  # O(1)
if [ -n "${HOME:-}${SUPERLITE_HOME:-}" ] && [ ! -f "$prefs" ]; then  # O(1)
  need_prefer=1  # O(1)
elif [ -f "$prefs" ]; then  # O(1)
  need_prefer=1  # O(1)
  IFS= read -r -d '' pref_body < "$prefs" || true  # O(file)
  [[ $pref_body == *'"agent_specs"'* ]] && need_prefer=0  # O(file)
else  # O(1)
  need_prefer=0  # O(1)
fi  # O(1)
if [ "${need_prefer:-0}" = 1 ]; then  # O(1)
  content="${content}"$'

'"Ask once (plain text, one question): does the user want pre-implementation specs on by default? Specs define what done looks like and why; plans choose how. Default stays off until they choose. After they answer, run: bash ${PLUGIN_ROOT}/skills/swarm/scripts/sl agent_specs prefer on|off. Do not ask again after prefer is recorded."  # O(s)
fi  # O(1)

# Always-on cost line when a superlite session is already active in this project.
cost_line=""  # O(1)
if [ -d .superlite ] && [ "${SUPERLITE_NO_COST_REPORT:-}" != "1" ]; then  # O(1)
  cost_line="$("$py" "${PLUGIN_ROOT}/skills/swarm/scripts/cost_live.py" .superlite 2>/dev/null || true)"  # O(R)
fi  # O(1)
if [ -n "$cost_line" ]; then  # O(1)
  content="${content}"$'

'"${cost_line}"  # O(s)
fi  # O(1)

if [ -n "$hud_line" ]; then  # O(1)
  content="${content}"$'

'"${hud_line}"  # O(s)
fi  # O(1)

# A superlite run suspends peer process plugins. The marker is removed by sl finish.
peers_file=".superlite/peers.json"  # O(1)
if [ -f "$peers_file" ]; then  # O(1)
  IFS= read -r -d '' peers_body < "$peers_file" || true  # O(file)
  re_susp='"suspended"[[:space:]]*:[[:space:]]*true'  # O(1)
  if [[ $peers_body =~ $re_susp ]]; then  # O(file)
    content="${content}"$'

'"Peer process plugins are suspended for this superlite run: superpowers, and anything else that carries the same lifecycle skills. Do not load their skills. When this run finishes they can be used again."  # O(s)
  fi  # O(1)
fi  # O(1)

escaped=$(escape_for_json "$content")  # O(s) + subshell
session_context="You have superlite. Its 'superlite:using-superlite' skill follows; load other skills with the Skill tool.\n\n${escaped}"  # O(s)

# Emit only the field the current platform consumes:
# - Cursor sets CURSOR_PLUGIN_ROOT (and may also set CLAUDE_PLUGIN_ROOT) and expects additional_context (snake_case).
# - Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI or MUSE_PLUGIN_ROOT and expects
#   hookSpecificOutput.additionalContext (nested). It reads BOTH forms without deduplication, so never emit both.
# - Muse sets MUSE_PLUGIN_ROOT; it accepts the Claude-style nested output.
# - Copilot CLI (sets COPILOT_CLI=1) and unknown hosts expect top-level additionalContext (SDK standard).
# printf only (no heredoc) to avoid the bash 5.3+ heredoc hang.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then  # O(1)
  printf '{"additional_context":"%s"}\n' "$session_context"  # O(s)
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "${MUSE_PLUGIN_ROOT:-}" ]; then  # O(1)
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$session_context"  # O(s)
elif [ -n "${MUSE_PLUGIN_ROOT:-}" ]; then  # O(1)
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$session_context"  # O(s)
else  # O(1)
  printf '{"additionalContext":"%s"}\n' "$session_context"  # O(s)
fi  # O(1)

exit 0  # O(1)
