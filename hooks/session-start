#!/usr/bin/env bash
# SessionStart hook for the superlite plugin (Claude Code, Cursor, Copilot CLI, Muse and other SDK-style hosts)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

content=$(cat "${PLUGIN_ROOT}/skills/using-superlite/SKILL.md" 2>&1 || echo "Error reading using-superlite skill")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\r'/}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Interpreter for the helper scripts: $SUPERLITE_PYTHON, else python, else python3 (builtin probe, no spawn).
py="${SUPERLITE_PYTHON:-}"
if [ -z "$py" ]; then
  if command -v python >/dev/null 2>&1; then py=python; else py=python3; fi
fi

# Which superlite session (slug, branch, worktree) this checkout is, when sessions are registered.
hud_line=""
hud_off="${SUPERLITE_NO_SESSION_HUD:-}"
if [ -d .superlite ] || [ -f .git ]; then
  hud_line="$(SUPERLITE_NO_SESSION_HUD=0 "$py" "${PLUGIN_ROOT}/skills/swarm/scripts/session_hud.py" . 2>/dev/null || true)"
fi

# Project state hint for the start menu: bash builtins only (no spawned process).
state="empty folder"
shopt -s nullglob dotglob
entries=(./*)
hud_first="${hud_line%%$'\n'*}"
if [[ $hud_first == *' | run:open'* ]] && [ -f .superlite/orchestrator.json ]; then
  state="run in progress"
elif [[ $hud_first == *' | run:'* ]]; then
  state="existing code"
elif [ -f .superlite/orchestrator.json ] && [ -d docs/plans ]; then
  state="run in progress"
elif [ -d .git ] || [ "${#entries[@]}" -gt 0 ]; then
  state="existing code"
fi
shopt -u nullglob dotglob
content="${content}"$'

'"Project state: ${state}."

# First session after this version is installed: show the intro screen once. The marker lives in
# $SUPERLITE_HOME (default $XDG_DATA_HOME/superlite, else ~/.local/share/superlite), one file per version, so an upgrade shows it again.
version=""
if [ -f "${PLUGIN_ROOT}/.claude-plugin/plugin.json" ]; then
  IFS= read -r -d '' pj < "${PLUGIN_ROOT}/.claude-plugin/plugin.json" || true
  re_ver='"version"[[:space:]]*:[[:space:]]*"([^"]+)"'
  [[ $pj =~ $re_ver ]] && version="${BASH_REMATCH[1]}"
fi
# Same rule as history.home() in skills/swarm/scripts/history.py: change both together.
if [ -n "${SUPERLITE_HOME:-}" ]; then home="$SUPERLITE_HOME"
elif [[ ${XDG_DATA_HOME:-} == /* ]]; then home="${XDG_DATA_HOME}/superlite"
else home="${HOME:-}/.local/share/superlite"
fi
marker="${home}/intro-shown-${version:-unknown}"
if [ -n "${HOME:-}${SUPERLITE_HOME:-}" ] && [ -f "${PLUGIN_ROOT}/assets/intro.txt" ] && [ ! -e "$marker" ]; then
  { [ -d "$home" ] || mkdir -p "$home"; } 2>/dev/null && : > "$marker" 2>/dev/null || true  # first run only: one spawn
  # Embed the screen here: the plugin path is outside the project, so a Read of
  # assets/intro.txt often fails or is skipped on a fresh install.
  IFS= read -r -d '' intro_body < "${PLUGIN_ROOT}/assets/intro.txt" || true
  intro_body="${intro_body//$'\r'/}"
  if [ -n "$intro_body" ]; then
    content="${content}"$'

'"superlite ${version} was just installed. Before anything else in your first reply, print the following intro screen to the user verbatim inside one text code block (do not call Read for it), then continue with their request. Do this only once.

\`\`\`text
${intro_body}
\`\`\`"
  fi
fi

# One-time prefer for pre-impl specs (default remains off until prefer on). Marker: agent_specs key in preferences.json.
prefs="${home}/preferences.json"
if [ -n "${HOME:-}${SUPERLITE_HOME:-}" ] && [ ! -f "$prefs" ]; then
  need_prefer=1
elif [ -f "$prefs" ]; then
  need_prefer=1
  IFS= read -r -d '' pref_body < "$prefs" || true
  [[ $pref_body == *'"agent_specs"'* ]] && need_prefer=0
else
  need_prefer=0
fi
if [ "${need_prefer:-0}" = 1 ]; then
  content="${content}"$'

'"Ask once (plain text, one question): does the user want pre-implementation specs on by default? Specs define what done looks like and why; plans choose how. Default stays off until they choose. After they answer, run: bash ${PLUGIN_ROOT}/skills/swarm/scripts/superlite-cli agent_specs prefer on|off. Do not ask again after prefer is recorded."
fi

# Always-on cost line when a superlite session is already active in this project.
cost_line=""
if [ -d .superlite ] && [ "${SUPERLITE_NO_COST_REPORT:-}" != "1" ]; then
  cost_line="$("$py" "${PLUGIN_ROOT}/skills/swarm/scripts/cost.py" line .superlite 2>/dev/null || true)"
fi
if [ -n "$cost_line" ]; then
  content="${content}"$'

'"${cost_line}"
fi

if [ -n "$hud_line" ] && [ "$hud_off" != "1" ]; then
  content="${content}"$'

'"${hud_line}"
fi

# A superlite run suspends peer process plugins. The marker is removed by superlite-cli finish.
peers_file=".superlite/peers.json"
if [ -f "$peers_file" ]; then
  IFS= read -r -d '' peers_body < "$peers_file" || true
  re_susp='"suspended"[[:space:]]*:[[:space:]]*true'
  if [[ $peers_body =~ $re_susp ]]; then
    content="${content}"$'

'"Peer process plugins are suspended for this superlite run: superpowers, and anything else that carries the same lifecycle skills. Do not load their skills. When this run finishes they can be used again."
  fi
fi

escaped=$(escape_for_json "$content")
session_context="You have superlite. Its 'superlite:using-superlite' skill follows; load other skills with the Skill tool.\n\n${escaped}"

# Emit only the field the current platform consumes:
# - Cursor sets CURSOR_PLUGIN_ROOT (and may also set CLAUDE_PLUGIN_ROOT) and expects additional_context (snake_case).
# - Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI or MUSE_PLUGIN_ROOT and expects
#   hookSpecificOutput.additionalContext (nested). It reads BOTH forms without deduplication, so never emit both.
# - Muse sets MUSE_PLUGIN_ROOT; it accepts the Claude-style nested output.
# - Copilot CLI (sets COPILOT_CLI=1) and unknown hosts expect top-level additionalContext (SDK standard).
# printf only (no heredoc) to avoid the bash 5.3+ heredoc hang.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{"additional_context":"%s"}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "${MUSE_PLUGIN_ROOT:-}" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$session_context"
elif [ -n "${MUSE_PLUGIN_ROOT:-}" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$session_context"
else
  printf '{"additionalContext":"%s"}\n' "$session_context"
fi

exit 0
