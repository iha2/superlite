{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "git -c 'alias.superlite-hook=!cd \"${GIT_PREFIX:-.}\" && exec bash ./hooks/session-start' superlite-hook"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "git -c 'alias.superlite-hook=!cd \"${GIT_PREFIX:-.}\" && exec bash ./hooks/prompt' superlite-hook"
      }
    ],
    "preToolUse": [
      {
        "command": "git -c 'alias.superlite-hook=!cd \"${GIT_PREFIX:-.}\" && exec bash ./hooks/pre-tool' superlite-hook"
      }
    ],
    "subagentStart": [
      {
        "command": "git -c 'alias.superlite-hook=!cd \"${GIT_PREFIX:-.}\" && exec bash ./hooks/capture-agent-launch' superlite-hook"
      }
    ],
    "subagentStop": [
      {
        "command": "git -c 'alias.superlite-hook=!cd \"${GIT_PREFIX:-.}\" && exec bash ./hooks/capture-agent-stop' superlite-hook"
      },
      {
        "command": "git -c 'alias.superlite-hook=!cd \"${GIT_PREFIX:-.}\" && exec bash ./hooks/capture-host-usage' superlite-hook"
      }
    ],
    "stop": [
      {
        "command": "git -c 'alias.superlite-hook=!cd \"${GIT_PREFIX:-.}\" && exec bash ./hooks/capture-host-usage' superlite-hook"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "git -c 'alias.superlite-hook=!cd \"${GIT_PREFIX:-.}\" && exec bash ./hooks/capture-host-usage' superlite-hook"
      }
    ]
  }
}
