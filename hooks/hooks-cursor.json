{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "git -c 'alias.sl-hook=!cd \"${GIT_PREFIX:-.}\" && exec bash ./hooks/session-start' sl-hook"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "git -c 'alias.sl-hook=!cd \"${GIT_PREFIX:-.}\" && exec bash ./hooks/record-human-reply' sl-hook"
      }
    ],
    "preToolUse": [
      {
        "command": "git -c 'alias.sl-hook=!cd \"${GIT_PREFIX:-.}\" && exec bash ./hooks/block-coordinator-edits' sl-hook"
      }
    ],
    "subagentStart": [
      {
        "command": "git -c 'alias.sl-hook=!cd \"${GIT_PREFIX:-.}\" && exec bash ./hooks/capture-agent-launch' sl-hook"
      }
    ],
    "subagentStop": [
      {
        "command": "git -c 'alias.sl-hook=!cd \"${GIT_PREFIX:-.}\" && exec bash ./hooks/capture-agent-stop' sl-hook"
      }
    ]
  }
}
