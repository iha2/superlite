{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash ./hooks/session-start"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash ./hooks/record-human-reply"
      }
    ],
    "subagentStart": [
      {
        "command": "bash ./hooks/capture-agent-launch"
      }
    ],
    "subagentStop": [
      {
        "command": "bash ./hooks/capture-agent-stop"
      }
    ]
  }
}
