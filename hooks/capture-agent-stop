#!/usr/bin/env bash
# SubagentStop hook: during an active superlite run, append one stop record to
# <project>/.superlite/metrics.jsonl:
#   {"ev":"stop","t":<epoch ms>,"agent_id":..,"type":..,"transcript":<path, forward slashes>,"last":<max 160 chars>}
# Active when .superlite/stable.json, prime.md, pool.json, orchestrator.json or feature.json exists.
# Bash builtins only (each external process costs ~250 ms on Windows). Never blocks: always exits 0.

IFS= read -r -d '' input   # builtin; returns 1 at EOF, which is fine

# jstr KEY: first JSON string value for KEY, decoded, into REPLY (empty if absent).
jstr() {
  local re='"'"$1"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"' s
  REPLY=""
  [[ $input =~ $re ]] || return 0
  s="${BASH_REMATCH[1]}"
  s="${s//\\\\/$'\x01'}"; s="${s//\\\"/\"}"; s="${s//\\n/ }"; s="${s//\\r/}"; s="${s//\\t/ }"; s="${s//\\\//\/}"
  REPLY="${s//$'\x01'/\\}"
}
# esc VAR: JSON-escape the string in VAR.
esc() {
  local s="${!1}"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/ }"; s="${s//$'\r'/}"; s="${s//$'\t'/ }"
  printf -v "$1" '%s' "$s"
}

jstr cwd; proj="${CLAUDE_PROJECT_DIR:-${REPLY//\\//}}"
[ -n "$proj" ] || proj="$PWD"
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=./_sl_state_dir.sh
. "$HOOK_DIR/_sl_state_dir.sh"
sl_resolve_state_dir "$proj"
sl_run_marker "$sd" || exit 0

jstr agent_id; id="$REPLY"
if [ -z "$id" ]; then jstr subagent_id; id="$REPLY"; fi   # Cursor subagentStop
jstr agent_type; type="$REPLY"
if [ -z "$type" ]; then jstr subagent_type; type="$REPLY"; fi
jstr agent_transcript_path; tr="${REPLY//\\//}"
jstr last_assistant_message; last="$REPLY"
if [ -z "$last" ]; then jstr summary; last="$REPLY"; fi
if [ -z "$last" ]; then jstr description; last="$REPLY"; fi
last="${last:0:160}"
esc id; esc type; esc tr; esc last

now="${EPOCHREALTIME//[.,]/}"; now="${now:0:${#now}-3}"
printf '{"ev":"stop","t":%s,"agent_id":"%s","type":"%s","transcript":"%s","last":"%s"}\n' \
  "$now" "$id" "$type" "$tr" "$last" >> "$proj/.superlite/metrics.jsonl" 2>/dev/null
exit 0
