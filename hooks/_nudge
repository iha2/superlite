# Sourced by hooks/prompt: when a superlite session is due for compact, put the host-neutral nudge line in
# NUDGE. Empty when SUPERLITE_NO_AUTOCOMPACT=1, when there is no run folder, or when not due.
# Needs $py (set by hooks/prompt). One Python call (compact_due).

compact_nudge() {
  NUDGE=""
  [ "${SUPERLITE_NO_AUTOCOMPACT:-}" = "1" ] && return 0
  [ -d "$sd" ] || return 0
  NUDGE="$("$py" "$root/skills/swarm/scripts/compact_due.py" "$sd" 2>/dev/null)" || NUDGE=""
}
