#!/usr/bin/env bash
# PostToolUse hook (matcher Agent): during an active superlite run, append one launch record to
# <project>/.superlite/metrics.jsonl:
#   {"ev":"launch","t":<epoch ms>,"agent_id":..,"type":..,"model":..,"desc":<max 120 chars>,"parent":<calling subagent's id, "" from the main session>}
# Active when .superlite/stable.json, prime.md, pool.json, orchestrator.json or feature.json exists.
# Bash builtins only (each external process costs ~250 ms on Windows). Never blocks: always exits 0.

IFS= read -r -d '' input   # builtin; returns 1 at EOF, which is fine

# jstr KEY: first JSON string value for KEY, decoded, into REPLY (empty if absent).
jstr() {
  local re='"'"$1"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"' s
  REPLY=""
  [[ $input =~ $re ]] || return 0
  s="${BASH_REMATCH[1]}"
  s="${s//\\\\/$'\x01'}"; s="${s//\\\"/\"}"; s="${s//\\n/ }"; s="${s//\\r/}"; s="${s//\\t/ }"; s="${s//\\\//\/}"
  REPLY="${s//$'\x01'/\\}"
}
# esc VAR: JSON-escape the string in VAR.
esc() {
  local s="${!1}"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/ }"; s="${s//$'\r'/}"; s="${s//$'\t'/ }"
  printf -v "$1" '%s' "$s"
}

jstr tool_name; tool="$REPLY"
case "$tool" in ''|Agent|Task) ;; *) exit 0 ;; esac

jstr cwd; proj="${CLAUDE_PROJECT_DIR:-${REPLY//\\//}}"
[ -n "$proj" ] || proj="$PWD"
[ -f "$proj/.superlite/stable.json" ] || [ -f "$proj/.superlite/prime.md" ] || [ -f "$proj/.superlite/pool.json" ] || [ -f "$proj/.superlite/orchestrator.json" ] || [ -f "$proj/.superlite/feature.json" ] || exit 0

jstr agentId; id="$REPLY"                 # Claude tool_response.agentId
if [ -z "$id" ]; then jstr subagent_id; id="$REPLY"; fi   # Cursor subagentStart
jstr subagent_type; type="$REPLY"
jstr resolvedModel; model="$REPLY"
if [ -z "$model" ]; then jstr subagent_model; model="$REPLY"; fi
jstr description; desc="$REPLY"
if [ -z "$desc" ]; then jstr task; desc="$REPLY"; fi
desc="${desc:0:120}"
jstr agent_id; parent="$REPLY"   # the calling subagent; absent on the main thread and on Cursor
esc id; esc type; esc model; esc desc; esc parent

now="${EPOCHREALTIME//[.,]/}"; now="${now%???}"   # epoch ms
# bash 3.2 (stock macOS) has no EPOCHREALTIME: date's %N (GNU, newer macOS), else perl, else whole seconds.
[[ $now =~ ^[0-9]{13,}$ ]] || { now="$(date +%s%N)"; now="${now%??????}"; }
[[ $now =~ ^[0-9]{13,}$ ]] || now="$(perl -MTime::HiRes=time -e 'printf "%d", time*1000' 2>/dev/null)"
[[ $now =~ ^[0-9]{13,}$ ]] || now="$(date +%s)000"
printf '{"ev":"launch","t":%s,"agent_id":"%s","type":"%s","model":"%s","desc":"%s","parent":"%s"}\n' \
  "$now" "$id" "$type" "$model" "$desc" "$parent" >> "$proj/.superlite/metrics.jsonl" 2>/dev/null
exit 0
